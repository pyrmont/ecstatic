(import ../deps/gum/test :prefix "")

(import ../lib/paginate)

(defn- message [f]
  (try (do (f) nil) ([e] e)))

(deftest pages
  (is (== [{:number 1 :items [1 2] :next 2 :pages 3 :total 5}
           {:number 2 :items [3 4] :previous 1 :next 3 :pages 3 :total 5}
           {:number 3 :items [5] :previous 2 :pages 3 :total 5}]
          (paginate/pages [1 2 3 4 5] 2))))

(deftest one-page
  (is (== [{:number 1 :items [1 2] :pages 1 :total 2}] (paginate/pages [1 2] 10))))

(deftest no-items
  (is (== [{:number 1 :items [] :pages 1 :total 0}] (paginate/pages [] 10))))

(deftest bad-page-size
  (each n [0 -1 1.5 "2"]
    (is (== (string/format "items per page must be a positive integer, got %q" n)
            (message #(paginate/pages [1] n))))))

(run-tests!)

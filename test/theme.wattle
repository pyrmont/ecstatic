(import ../deps/gum/test :prefix "")
(import ../res/helpers/util :as h)

(import ../lib/theme)

; The cmark module must be built first with `wattle build lib`.

(def- dir "tmp/test/theme")

(defn- load-site [files]
  (theme/load (h/make-site dir files)))

(defn- message [f]
  (try (do (f) nil) ([e] e)))

(deftest load-theme
  (def env (load-site {"_ecstatic.wattle"
                       """
                       (def config {:title "Test"})
                       (defn build [site] [])
                       """}))
  (is (== {:title "Test"} (theme/lookup env 'config)))
  (is (function? (theme/lookup env 'build)))
  (is (nil? (theme/lookup env 'missing))))

(deftest load-theme-with-relative-import
  (def env (theme/load (h/copy "layout" dir)))
  (is (== [{:path "index.html" :body "<h1>Test</h1>"}]
          ((theme/lookup env 'build) {:config {:title "Test"}}))))

(deftest load-theme-with-exposed-bindings
  (def env (load-site {"_ecstatic.wattle"
                       """
                       (defn build [site]
                         (markdown/render "*x*" {:transforms [(fn [root] (cmark/nodes root))]}))
                       """}))
  (is (== "<p><em>x</em></p>\n" ((theme/lookup env 'build) {}))))

(deftest load-theme-without-build
  (h/make-site dir {"_ecstatic.wattle" "(def config {})"})
  (is (== (string dir "/_ecstatic.wattle does not define build as a function")
          (message #(theme/load dir)))))

(deftest load-theme-with-build-not-a-function
  (h/make-site dir {"_ecstatic.wattle" "(def build 1)"})
  (is (== (string dir "/_ecstatic.wattle does not define build as a function")
          (message #(theme/load dir)))))

(deftest load-missing-theme
  (h/make-site dir {"index.md" ""})
  (is (== (string "cannot find " dir "/_ecstatic.wattle")
          (message #(theme/load dir)))))

(deftest load-theme-with-compile-error
  (h/make-site dir {"_ecstatic.wattle" "(defn build [site] (oops))"})
  (is (== (string dir "/_ecstatic.wattle:1:20: compile error: unknown symbol oops")
          (message #(theme/load dir)))))

(defer (h/rmrf dir)
  (run-tests!))
